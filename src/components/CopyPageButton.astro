---
/**
 * 페이지 본문을 Markdown으로 클립보드에 복사하는 버튼.
 * Claude docs의 "Copy page"와 비슷하되, 메뉴 없이 한 번에 복사만 한다.
 */
interface Props {
	/** 클립보드에 넣을 Markdown 원문 */
	markdown: string;
}

const { markdown } = Astro.props;
---

<button
	type="button"
	class="copy-page"
	data-copy-page
	aria-label="페이지를 Markdown으로 복사"
>
	<span class="copy-page__icon" aria-hidden="true">
		<svg class="copy-page__icon-copy" width="14" height="14" viewBox="0 0 16 16" fill="none">
			<rect
				x="5.5"
				y="5.5"
				width="8"
				height="8"
				rx="1.5"
				stroke="currentColor"
				stroke-width="1.4"
			></rect>
			<path
				d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
			></path>
		</svg>
		<svg class="copy-page__icon-check" width="14" height="14" viewBox="0 0 16 16" fill="none">
			<path
				d="M3.5 8.5 6.5 11.5 12.5 4.5"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
	</span>
	<span class="copy-page__label" data-copy-label>Copy page</span>
</button>

{/*
  본문은 버튼 data 속성에 넣지 않고 인접 JSON script로 보관.
  JSON.stringify로 따옴표·특수문자를 직렬화하고, 본문에 </script>가 있어도
  이 블록이 조기 종료되지 않도록 '<'를 \u003c로 이스케이프한다 (JSON.parse는 그대로 복원).
*/}
<script type="application/json" data-copy-source set:html={JSON.stringify(markdown).replaceAll('<', '\\u003c')} />

<script>
	function readCopySource(el: Element | null): string {
		if (!(el instanceof HTMLScriptElement) || el.dataset.copySource === undefined) {
			return '';
		}
		const raw = el.textContent ?? '';
		try {
			const parsed: unknown = JSON.parse(raw);
			return typeof parsed === 'string' ? parsed : '';
		} catch {
			return '';
		}
	}

	function markCopied(button: HTMLButtonElement, label: HTMLElement | null, idleLabel: string) {
		button.classList.add('is-copied');
		if (label) label.textContent = 'Copied';
		button.setAttribute('aria-label', '복사됨');
		window.setTimeout(() => {
			button.classList.remove('is-copied');
			if (label) label.textContent = idleLabel;
			button.setAttribute('aria-label', '페이지를 Markdown으로 복사');
		}, 1600);
	}

	function initCopyPageButtons() {
		const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy-page]');
		for (const button of buttons) {
			if (button.dataset.bound === '1') continue;
			button.dataset.bound = '1';

			const source = button.nextElementSibling;
			const label = button.querySelector<HTMLElement>('[data-copy-label]');
			const idleLabel = label?.textContent ?? 'Copy page';

			button.addEventListener('click', async () => {
				const text = readCopySource(source);
				if (!text) return;
				try {
					await navigator.clipboard.writeText(text);
					markCopied(button, label, idleLabel);
				} catch {
					// Clipboard API 실패 시 textarea fallback
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.setAttribute('readonly', '');
					ta.style.position = 'fixed';
					ta.style.left = '-9999px';
					document.body.appendChild(ta);
					ta.select();
					const ok = document.execCommand('copy');
					document.body.removeChild(ta);
					if (ok) markCopied(button, label, idleLabel);
				}
			});
		}
	}

	initCopyPageButtons();
	document.addEventListener('astro:page-load', initCopyPageButtons);
</script>

<style>
	.copy-page {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-left: auto;
		padding: 4px 10px;
		border: 1px solid var(--border);
		border-radius: var(--radius-m);
		background: transparent;
		color: rgb(var(--gray));
		font-family: inherit;
		font-size: 0.85em;
		line-height: 1.3;
		cursor: pointer;
		white-space: nowrap;
		flex-shrink: 0;
		transition:
			color 0.12s ease,
			border-color 0.12s ease,
			background-color 0.12s ease;
	}
	.copy-page:hover {
		color: rgb(var(--gray-dark));
		border-color: rgb(var(--gray));
		background: rgba(var(--gray-light), 0.45);
	}
	.copy-page:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.copy-page.is-copied {
		color: var(--accent);
		border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}
	.copy-page__icon {
		display: inline-flex;
		width: 14px;
		height: 14px;
		flex-shrink: 0;
	}
	.copy-page__icon-check {
		display: none;
	}
	.copy-page.is-copied .copy-page__icon-copy {
		display: none;
	}
	.copy-page.is-copied .copy-page__icon-check {
		display: block;
	}
	.copy-page__label {
		font-weight: 500;
	}
</style>
